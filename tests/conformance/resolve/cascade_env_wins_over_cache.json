{
  "name": "resolve_cascade_env_wins_over_cache",
  "description": "env.X or cache.P.F cascade takes the env term when both env and cache are present.",
  "virtual": { "myapp.workspace": "env.MYAPP_ENV or cache.myappcache.workspace" },
  "env": { "MYAPP_ENV": "prod-env" },
  "setup": [
    { "op": "put", "args": { "key": "myappcache", "data": { "workspace": "cache-env" } } }
  ],
  "test": { "op": "resolve", "args": { "key": "myapp.workspace" } },
  "expect": { "status": "hit", "data_type": "string", "data_equals": "prod-env" }
}
